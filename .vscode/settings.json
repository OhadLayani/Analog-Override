{
    "files.exclude": {
        // System & Version Control
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.gitmodules": true,
        "**/.vs": true,
        "**/.vsconfig": true,
        "**/*.gitignore": true,

        // IDE, Build & Cache Folders
        "build/": true,
        "Build/": true,
        "Builds/": true,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "Logs/": true,
        "logs/": true,
        "temp/": true,
        "Temp/": true,
        "ProjectSettings/": true,
        "UserSettings/": true,
        
        // IDE Configs & Legacy Project Files
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.editorconfig": true,

        // Binaries, Compiled & Cache Files
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.pdb": true,
        "**/*.bin": true,
        "**/*.o": true,
        "**/*.so": true,
        "**/*.dylib": true,
        "**/*.lib": true,
        "**/*.a": true,
        "**/*.gbc": true,
        "**/*.bytes": true,
        "**/*.db": true,
        "**/*.mvfrm": true,
        "**/*.rsp": true,
        "**/*.rsp2": true,
        "**/*.bhc": true,
        "**/*.bundle": true,
        "**/*.plist": true,
        "**/*.ModuleCompilationTrigger": true,

        // Unity Meta & Asset Files
        "**/*.meta": true,
        "**/*.asset": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "**/*.mat": true,
        "**/*.controller": true,
        "**/*.anim": true,
        "**/*.playable": true,
        "**/*.preset": true,
        "**/*.scenetemplate": true,
        "**/*.terrainlayer": true,
        "**/*.inputactions": true,
        "**/*.spriteatlasv2": true,
        "**/*.spriteLib": true,
        "**/*.lighting": true,

        // 3D Models & Art Assets
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.fbx": true,
        "**/*.FBX": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.cubemap": true,
        "**/*.flare": true,
        
        // 2D Media (Images, Video, Documents)
        "**/*.png": true,
        "**/*.PNG": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.psd": true,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.afphoto": true,
        "**/*.svg": true,
        "**/*.exr": true,
        "**/*.dds": true,
        "**/*.pdf": true,
        "**/*.webm": true,
        "**/*.mp4": true,

        // Audio & Fonts
        "**/*.mid": true,
        "**/*.midi": true,
        "**/*.wav": true,
        "**/*.mp3": true,
        "**/*.ttf": true,
        "**/*.otf": true,

        // Visual Shader Graphs (Keeps actual .shader text code visible)
        "**/*.shadergraph": true,
        "**/*.shadersubgraph": true,
        "**/*.ShaderSubGraph": true,
        "**/*.sgsubgraphdb": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml"
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj"
    },
    "dotnet.defaultSolution": "Analog-Override.slnx"
}